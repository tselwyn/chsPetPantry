# PFPMS web root (SiteGround public_html). PHP sends the security headers for pages;
# the rules here cover static files and requests that never reach PHP.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass the Authorization header to PHP (tablet credentials: CGI and FastCGI drop it otherwise). PHP reads
  # HTTP_AUTHORIZATION or REDIRECT_HTTP_AUTHORIZATION (Request::authorization()). Check with bin/station-smoke.php.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # HTTPS everywhere except local development hosts (localhost, 127.0.0.1, *.localhost).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\]|.*\.localhost)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # No dotfiles or dot-directories (.git, .env, .htaccess), except the ACME challenge path.
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

<FilesMatch "(?i)\.(sql|log|zip|7z|md|inc|ini|env|lock|bak|enc|sh|py|dist)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|woff2?|ttf|otf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # The Station's static files revalidate, so a new build reaches every tablet (<If> merges after <FilesMatch>).
  # Static extensions only: under Apache, Header set also replaces a PHP response's no-store.
  <If "%{REQUEST_URI} =~ m#/station/.*\.(js|css|json|png)$#">
    Header set Cache-Control "no-cache"
  </If>
</IfModule>
