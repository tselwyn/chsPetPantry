{
    "name": "chs/pfpms",
    "description": "CHS Pet Pantry: Pet Food Pantry Management System",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.2",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo_mysql": "*",
        "chillerlan/php-qrcode": "^5.0",
        "dompdf/dompdf": "^3.1",
        "phpmailer/phpmailer": "^7.0",
        "phpoffice/phpspreadsheet": "^5.6"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Pfpms\\": "src/"
        },
        "exclude-from-classmap": [
            "/tests/phpunit-shim.php",
            "/tests/run.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pfpms\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "guard": "php bin/ci-guard.php",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "phpunit"
    }
}
