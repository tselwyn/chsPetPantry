{
  "_comment": "Canonical JSON v1 (50-design \u00a73.6, D-33). valid: canonical(JSON.parse(json)) and Canonical::encode(json_decode(json, false)) give bytes, and bytes is canonical. invalid: not canonical on either side (bytes, or bytes_hex for bytes that are not UTF-8). sized: {\"s\":\"aaa\u2026\"} of exactly total_bytes.",
  "valid": [
    {
      "name": "key order",
      "json": "{\"b\":1,\"a\":2,\"c\":{\"z\":null,\"y\":true}}",
      "bytes": "{\"a\":2,\"b\":1,\"c\":{\"y\":true,\"z\":null}}"
    },
    {
      "name": "nesting",
      "json": "{\"list\":[{\"b\":[],\"a\":{}},[1,[2,[3]]]],\"n\":{\"m\":{\"l\":false}}}",
      "bytes": "{\"list\":[{\"a\":{},\"b\":[]},[1,[2,[3]]]],\"n\":{\"m\":{\"l\":false}}}"
    },
    {
      "name": "an empty object and an empty array stay apart",
      "json": "{\"a\":{},\"b\":[]}",
      "bytes": "{\"a\":{},\"b\":[]}"
    },
    {
      "name": "line and paragraph separators are literal",
