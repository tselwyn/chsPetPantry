roundColor=#ffffff;" edge="1" parent="1" source="category_r0" target="distitem_r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="title" value="PFPMS — Entity Relationship Diagram" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="40" as="geometry"/></mxCell><mxCell id="subtitle" value="Pet Food Pantry Management System · derived from chsPetPantry foodpantrydb.sql · crow&#39;s-foot notation" style="text;html=1;fontSize=13;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="760" y="26" width="700" height="30" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;background:#dae8fc;border:1px solid #6c8ebf&#x27;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Kept from chsPetPantry database&lt;br&gt;&lt;span style=&#x27;background:#d5e8d4;border:1px solid #82b366&#x27;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; New PFPMS entity&lt;br&gt;&lt;i&gt;&lt;font color=&#x27;#2d7600&#x27;&gt;green italic&lt;/font&gt;&lt;/i&gt; = new attribute on an existing table&lt;br&gt;PK primary key · FK foreign key · UK unique&lt;br&gt;Lines: | one (mandatory) · o&amp;lt; zero-to-many · |&amp;lt; one-to-many&lt;br&gt;&lt;br&gt;&lt;b&gt;Enum values&lt;/b&gt;&lt;br&gt;dbpersons.type: admin, volunteer&lt;br&gt;participant.status: Active, Inactive, Restricted&lt;br&gt;pet.species: Dog, Cat, Other · pet.size: Small, Medium, Large&lt;br&gt;alert.alert_type: Duplicate, Distribution Restriction, General&lt;br&gt;distribution_visit.pickup_method: Curbside, In-House&lt;br&gt;dbitemcategory.petType: Dog, Cat, Both, Other&lt;br&gt;&lt;br&gt;&lt;b&gt;Dropped from source DB&lt;/b&gt; (not needed for PFPMS)&lt;br&gt;dbclient, dbdistribution (replaced by distribution_visit),&lt;br&gt;dbshoppingcountgroup, events/attendance/applications,&lt;br&gt;shifts &amp;amp; hours, messages, drafts, discussions,&lt;br&gt;groups, suggestions, archived volunteers, verified IDs" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="340" height="470" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>